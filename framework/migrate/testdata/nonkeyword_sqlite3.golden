CREATE TABLE IF NOT EXISTS authors (
	id TEXT PRIMARY KEY NOT NULL,
	email VARCHAR(120) UNIQUE NOT NULL,
	status TEXT DEFAULT 'active',
	score INTEGER DEFAULT 0,
	created_at DATETIME,
	updated_at DATETIME
);
CREATE INDEX IF NOT EXISTS idx_authors_status_score ON authors (status, score);
CREATE UNIQUE INDEX IF NOT EXISTS ux_authors_lower_email ON authors (lower(email));
CREATE TABLE IF NOT EXISTS lines (
	post_id INTEGER NOT NULL,
	seq INTEGER NOT NULL,
	text TEXT,
	legacy TEXT,
	PRIMARY KEY (post_id, seq)
);
CREATE TABLE IF NOT EXISTS posts (
	id INTEGER PRIMARY KEY,
	author_id TEXT NOT NULL,
	title TEXT NOT NULL,
	body TEXT,
	meta TEXT,
	created_at DATETIME,
	updated_at DATETIME,
	deleted_at DATETIME,
	FOREIGN KEY (author_id) REFERENCES authors(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_posts_author_id ON posts (author_id);
CREATE TABLE IF NOT EXISTS tags (
	id TEXT PRIMARY KEY NOT NULL,
	label TEXT
);
CREATE TABLE IF NOT EXISTS author_tags (
	author_id TEXT NOT NULL,
	tag_id TEXT NOT NULL,
	PRIMARY KEY (author_id, tag_id),
	FOREIGN KEY (author_id) REFERENCES authors(id) ON DELETE CASCADE,
	FOREIGN KEY (tag_id) REFERENCES tags(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_author_tags_tag_id ON author_tags (tag_id);
---
