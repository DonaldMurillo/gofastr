---
ALTER TABLE lines DROP COLUMN legacy;
CREATE TABLE lines__rebuild (
	post_id INTEGER NOT NULL,
	seq INTEGER NOT NULL,
	text INTEGER,
	PRIMARY KEY (post_id, seq)
);
INSERT INTO lines__rebuild (post_id, seq, text) SELECT post_id, seq, text FROM lines;
DROP TABLE lines;
PRAGMA legacy_alter_table=ON;
ALTER TABLE lines__rebuild RENAME TO lines;
PRAGMA legacy_alter_table=OFF;
ALTER TABLE tags RENAME COLUMN label TO caption;
ALTER TABLE tags ADD COLUMN weight INTEGER;
CREATE INDEX IF NOT EXISTS idx_tags_weight ON tags (weight);
ALTER TABLE tags ADD COLUMN hits INTEGER DEFAULT 1;
CREATE UNIQUE INDEX IF NOT EXISTS tags_caption_key ON tags (caption);
---

