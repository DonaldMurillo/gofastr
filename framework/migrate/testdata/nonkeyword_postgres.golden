---
ALTER TABLE lines ALTER COLUMN text DROP DEFAULT, ALTER COLUMN text TYPE BIGINT USING text::BIGINT;
ALTER TABLE lines DROP COLUMN legacy;
ALTER TABLE tags RENAME COLUMN label TO caption;
ALTER TABLE tags ADD COLUMN weight BIGINT;
CREATE INDEX IF NOT EXISTS idx_tags_weight ON tags (weight);
ALTER TABLE tags ADD COLUMN hits BIGINT DEFAULT 1;
CREATE UNIQUE INDEX IF NOT EXISTS tags_caption_key ON tags (caption);
---
DROP INDEX IF EXISTS tags_caption_key;
ALTER TABLE tags DROP COLUMN hits;
DROP INDEX IF EXISTS idx_tags_weight;
ALTER TABLE tags DROP COLUMN weight;
ALTER TABLE tags RENAME COLUMN caption TO label;
ALTER TABLE lines ADD COLUMN legacy TEXT;
ALTER TABLE lines ALTER COLUMN text TYPE TEXT;
