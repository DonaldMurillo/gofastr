<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{xml .ID}}"
    android:versionCode="{{.VersionCode}}"
    android:versionName="{{xml .Version}}">

    <uses-sdk android:minSdkVersion="{{.MinSDK}}" android:targetSdkVersion="{{.TargetSDK}}" />

    <!-- The app never leaves the device. Kept for the prototype because
         WebView loads have been reported to fail without it even when
         every request is intercepted; VERIFY ON DEVICE whether it can go. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="{{xml .Name}}"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
