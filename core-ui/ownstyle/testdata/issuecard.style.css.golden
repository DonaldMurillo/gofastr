@scope ([data-cui-scope="issuecard"]) to (:scope [data-cui-scope]>*,[data-cui-internal]){:scope{display:grid;gap:var(--spacing-xs);padding:var(--spacing-sm) var(--spacing-md);border:1px solid var(--color-border);border-inline-start-width:3px;border-radius:var(--radii-md);background:var(--color-surface);color:inherit;text-decoration:none;transition:box-shadow var(--duration-fast) var(--easing-ease-out)}:scope:hover{box-shadow:var(--shadow-sm)}:scope:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}:scope[aria-current="true"]{border-color:var(--color-primary)}:scope.priority--urgent{border-inline-start-color:var(--color-danger)}:scope.priority--high{border-inline-start-color:var(--color-warning)}:scope.priority--low{border-inline-start-color:var(--color-border-strong)}:scope.fresh{animation:issuecard-settle var(--duration-slow) var(--easing-ease-out) 1}@media (prefers-reduced-motion: reduce){:scope.fresh{animation:none;background:color-mix(in srgb,var(--color-primary) 8%,var(--color-surface))}}.key{font:var(--text-xs)/1 var(--font-mono);color:var(--color-text-muted)}.title{font-size:var(--text-sm);display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--spacing-xs)}@container (min-width: 26rem){:scope{grid-template-columns:auto 1fr auto;align-items:center;column-gap:var(--spacing-md)}}}@keyframes issuecard-settle{from{background:color-mix(in srgb,var(--color-primary) 14%,var(--color-surface))}}
