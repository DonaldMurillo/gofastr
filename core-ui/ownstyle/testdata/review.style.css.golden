@scope ([data-cui-scope="review"]) to (:scope [data-cui-scope]>*,[data-cui-internal]){:scope{display:grid;gap:var(--spacing-md);grid-template-areas:"summary" "main" "comments"}@media (min-width: 768px){:scope{grid-template-columns:14rem minmax(0,1fr);grid-template-areas:"summary summary" "files   main" "files   comments"}}@media (min-width: 1280px){:scope{grid-template-columns:14rem minmax(0,1fr) 20rem;grid-template-areas:"summary summary summary" "files   main    comments"}}.summary{grid-area:summary}.files{grid-area:files;display:none}.main{grid-area:main}.comments{grid-area:comments}@media (min-width: 768px){.files{display:block;position:sticky;inset-block-start:var(--spacing-md);align-self:start}}}
