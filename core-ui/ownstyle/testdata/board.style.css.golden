@scope ([data-cui-scope="board"]) to (:scope [data-cui-scope]>*,[data-cui-internal]){:scope{display:grid;gap:var(--spacing-lg)}.columns{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(16rem,85%);gap:var(--spacing-md);overflow-x:auto;scroll-snap-type:x mandatory}@media (min-width: 768px){.columns{grid-auto-columns:minmax(16rem,1fr);scroll-snap-type:none}}.column{container-type:inline-size;display:grid;grid-template-rows:auto 1fr;gap:var(--spacing-sm);padding:var(--spacing-sm);scroll-snap-align:start;border-radius:var(--radii-lg);background:var(--color-surface-soft)}.column[data-drop-over]{outline:2px dashed var(--color-primary);outline-offset:-2px}.column.over-limit .count{color:var(--color-warning);font-weight:var(--font-weight-bold)}.header{display:flex;align-items:baseline;justify-content:space-between}h2{font:600 var(--text-sm)/1.3 var(--font-heading);margin:0}.count{font-size:var(--text-xs);color:var(--color-text-muted);font-variant-numeric:tabular-nums}.cards{display:grid;align-content:start;gap:var(--spacing-sm)}}@scope ([data-color-scheme="dark"] [data-cui-scope="board"]) to (:scope [data-cui-scope]>*,[data-cui-internal]){.column{background:var(--color-surface);box-shadow:inset 0 0 0 1px var(--color-border)}}@media (prefers-color-scheme: dark){@scope (:root:not([data-color-scheme="light"]) [data-cui-scope="board"]) to (:scope [data-cui-scope]>*,[data-cui-internal]){.column{background:var(--color-surface);box-shadow:inset 0 0 0 1px var(--color-border)}}}
