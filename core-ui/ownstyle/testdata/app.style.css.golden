@scope (:root) to ([data-cui-internal]){.figure{font-variant-numeric:tabular-nums;letter-spacing:var(--tracking-snug)}.one-line{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-inline-size:0}.issue-key{font:var(--text-xs)/1 var(--font-mono);color:var(--color-text-muted)}.pane-scroll{overflow-y:auto;overscroll-behavior:contain;min-block-size:0}.priority.level--urgent{color:var(--color-danger)}.priority.level--high{color:var(--color-warning)}.split{display:flex;flex-direction:column;gap:var(--spacing-sm)}@media (min-width: 768px){.split{flex-direction:row;align-items:center;justify-content:space-between}}}
