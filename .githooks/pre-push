#!/bin/sh
# GoFastr pre-push hook: safety net behind pre-commit.
#
# Re-runs the deterministic CI test sweep when a commit skipped it
# (GOFASTR_SKIP_COMMIT_TESTS=1 or --no-verify), then the coverage
# floors, then the heavy chromedp suites serialized at -p 1 (CI's
# browser-e2e isolation, one suite per runner there), then module
# integrity and govulncheck. The old `go test -race ./...` is gone: it
# took half an hour and swept the packages CI deliberately excludes as
# flaky-by-design (core-ui/runtime, core-ui/widget, examples/site),
# use `make test-race` for a deliberate race pass.
#
# Enable once per clone: make hooks
# Skip the sweep once (CI still gates): GOFASTR_SKIP_PUSH_TESTS=1 git push

set -e

RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
NC='\033[0m'

pass() { printf "  ${GREEN}✓${NC} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${NC} %s\n" "$1"; }
fail() { printf "  ${RED}✗${NC} %s\n" "$1"; }

# Git feeds ref updates on stdin: "<local ref> <local sha> <remote ref>
# <remote sha>" per line, with an all-zero local sha for a deletion. A
# push that ONLY deletes remote branches ships no code, so there is
# nothing for the gate to test, skip it. Any line with a real local
# sha keeps the full gate.
ZERO=0000000000000000000000000000000000000000
only_deletions=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  if [ "$local_sha" = "$ZERO" ]; then
    only_deletions="${only_deletions:-yes}"
  else
    only_deletions="no"
  fi
done
if [ "$only_deletions" = "yes" ]; then
  echo ""
  echo "  Pre-push gate: branch deletion only — nothing to test, skipping."
  echo ""
  exit 0
fi

# Git runs hooks with GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE (etc.)
# pointing at THIS repo; they inherit into the test sweep, whose tests
# shell out to `git init` / `git status` in temp fixtures and would then
# target this repo and fail. Unset git's own location vars so the sweep
# runs clean, exactly like CI (which runs tests outside any hook).
unset $(git rev-parse --local-env-vars 2>/dev/null) 2>/dev/null || true

echo ""
echo "  Pre-push gate..."
echo ""

# ---- 1. Deterministic test sweep (CI-identical; keep in sync with
#          .github/workflows/ci.yml and .githooks/pre-commit) ----
if [ "${GOFASTR_SKIP_PUSH_TESTS:-}" = "1" ]; then
  warn "test sweep skipped (GOFASTR_SKIP_PUSH_TESTS=1) — CI still gates"
else
  # CI's browser isolation set, in ONE variable: the chromedp packages
  # the sweep below excludes are exactly the ones the serialized step
  # after the floors re-runs via -match on the same regex, so the two
  # lists cannot drift.
  HEAVY_RE='gofastr/(examples/site|examples/meridian|examples/tracker|examples/layoutlab|kiln/integration|core-ui/runtime|core-ui/widget|evals/ui-quality/internal/evalrunner|framework/headless)$'
  # The four cmd/gofastr tests CI runs serialized in its browser-e2e
  # gofastr-cli shard: three drive a real Chrome over the dev livereload
  # websocket, one builds and boots every example.
  CLI_BROWSER_TESTS='TestBlueprintCLIGeneratesEntireWorkingAppE2E|TestE2E_HotReload_BrowserAutoRefreshes|TestLivereloadSameBuildIDDoesNotReload|TestE2E_DevLoop_Examples'

  echo "  → Deterministic test sweep..."
  # Affected packages only (cmd/affected: the import-graph closure of what
  # differs from origin/main; GOFASTR_TEST_ALL=1 widens to the whole tree).
  # No -count=1: cached PASSes on unchanged packages keep repeat pushes
  # fast (same content-addressed cache CI relies on). The -exclude list is
  # CI's: the chromedp suites that run isolated in browser-e2e, and here
  # serialized at -p 1 in the step below the floors. The merged
  # coverprofile feeds the floors check below, so the suites run once.
  coverprofile=$(mktemp)
  trap 'rm -f "$coverprofile"' EXIT
  go run ./cmd/affected \
    -exclude "$HEAVY_RE" \
    -- go test -timeout=20m -coverprofile="$coverprofile" \
    -skip "$CLI_BROWSER_TESTS"
  pass "Deterministic tests passed"

  echo ""
  COVERPROFILE="$coverprofile" bash scripts/coverage-floors.sh
  pass "Coverage floors hold"

  # ---- 1b. Serialized browser suites (CI's browser-e2e set) ----
  # The packages the sweep excluded run here at -p 1: they contend for
  # Chrome and the ephemeral-port range when they share a go-test run,
  # which is why CI gives each one its own runner. cmd/affected skips
  # the command when the change reaches nothing in the set, so pushes
  # that touch no heavy package pay nothing here.
  echo ""
  echo "  → Serialized browser suites (affected heavy packages, -p 1)..."
  go run ./cmd/affected -match "$HEAVY_RE" -- go test -p 1 -timeout=20m
  pass "Serialized browser suites passed"

  # The four cmd/gofastr browser tests the sweep skipped, serialized,
  # only when cmd/gofastr is affected.
  echo ""
  echo "  → Serialized cmd/gofastr browser tests (-p 1)..."
  go run ./cmd/affected -match 'gofastr/cmd/gofastr$' -- go test -p 1 -timeout=20m -run "$CLI_BROWSER_TESTS"
  pass "Serialized cmd/gofastr browser tests passed"
fi

# ---- 2. Vulnerability check ----
echo ""
if command -v govulncheck >/dev/null 2>&1; then
  echo "  → Running govulncheck..."
  if govulncheck ./...; then
    pass "No known vulnerabilities"
  else
    fail "Vulnerabilities found!"
    echo ""
    echo "  Install: go install golang.org/x/vuln/cmd/govulncheck@latest"
    exit 1
  fi
else
  warn "govulncheck not installed (optional)"
  echo "    Install: go install golang.org/x/vuln/cmd/govulncheck@latest"
fi

# ---- 3. Module integrity ----
echo ""
echo "  → Checking go.sum integrity..."
go mod verify
pass "Module integrity verified"

echo ""
pass "Pre-push checks passed"
echo ""
