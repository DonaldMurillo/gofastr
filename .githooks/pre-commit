#!/bin/sh
# GoFastr pre-commit hook: CI's "build · vet · test" job, locally.
#
# Runs the same blocking steps as .github/workflows/ci.yml's first job
# (build, gofmt on tracked files, vet, the deterministic test sweep,
# coverage floors) plus a secrets/sensitive-file scan, so a commit that
# would fail CI fails HERE first. Keep the test command in sync with the
# workflow when editing either.
#
# Vet and the test sweep run over the AFFECTED packages (cmd/affected: the
# import-graph closure of what differs from origin/main, working tree
# included); the base is the branch point, so a long branch re-tests its
# whole affected set on every commit and Go's test cache makes the unchanged
# part of that instant. GOFASTR_TEST_ALL=1 widens every step to the whole
# tree; so does any change to go.mod, go.sum or cmd/affected.
#
# Enable once per clone: make hooks
# Emergency bypass:      git commit --no-verify   (CI still gates)
# Skip only the slow test sweep (e.g. docs-only commit):
#   GOFASTR_SKIP_COMMIT_TESTS=1 git commit ...    (pre-push re-runs it)
#
# The model review (.claude/skills/review-gate) runs three reviews of the
# staged change beside the test sweep and fails the commit only when all
# three request changes. The reviewer is the Codex CLI (review3.py looks
# past PATH to the usual install spots first); without Codex it is the
# Claude Code CLI on Haiku. With neither, the hook warns and lets the
# commit through: run the skill's subagent mode before you push. No
# Python or an incomplete review warns and lets the commit through too,
# and so does a run past GOFASTR_COMMIT_REVIEW_TIMEOUT seconds (default
# 600). To skip the review, or overrule a block you read and rejected
# (say why in the commit message):
#   GOFASTR_SKIP_COMMIT_REVIEW=1 git commit ...

set -e

# Drop git's libexec from PATH so the sweep shares Go test cache entries
# with a shell run. Sourced from the hook's own checkout.
. "${0%/*}/../internal/hookenv/strip-git-path.sh"

RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
NC='\033[0m'

pass() { printf "  ${GREEN}✓${NC} %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${NC} %s\n" "$1"; }
fail() { printf "  ${RED}✗${NC} %s\n" "$1"; }

# The index this commit is built from. `git commit <paths>` builds it in a
# temporary file that git names in GIT_INDEX_FILE, and the unset below
# clears that variable, after which `git diff --cached` reads the real
# index: the secret scan then checked what was staged there instead of
# what is being committed. Every "what is staged" read goes through
# staged_git.
commit_index=${GIT_INDEX_FILE:-}
case "$commit_index" in
  ""|/*|[A-Za-z]:*) ;;
  *) commit_index="$(pwd)/$commit_index" ;;
esac
staged_git() {
  if [ -n "$commit_index" ]; then
    GIT_INDEX_FILE=$commit_index git "$@"
  else
    git "$@"
  fi
}

# Temp files and the background review, cleaned up however the hook exits.
# One quoted variable per path: a list expanded unquoted would split a
# TMPDIR with a space in it and hand rm -rf the pieces.
vettool_dir=""
coverprofile=""
review_out=""
scan_blob=""
review_pid=""
cleanup() {
  if [ -n "$review_pid" ]; then
    kill "$review_pid" 2>/dev/null || true
    wait "$review_pid" 2>/dev/null || true
  fi
  for path in "$vettool_dir" "$coverprofile" "$review_out" "$scan_blob"; do
    if [ -n "$path" ]; then rm -rf "$path"; fi
  done
}
trap cleanup EXIT

# Git runs hooks with GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE (etc.)
# pointing at THIS repo, and they inherit into every child process. The
# test sweep shells out to `git init` / `git status` in temp dirs
# (gofastr init, the onboarding evals), which would then target this repo
# instead of their fixture and fail. Unset git's own location vars so the
# sweep runs in a clean environment, exactly like CI (which runs tests as
# a plain step, not inside a hook).
unset $(git rev-parse --local-env-vars 2>/dev/null) 2>/dev/null || true

# ---- 1. Build ----
echo ""
go build ./...
pass "go build ./..."

# ---- 2. Format check (tracked files only, gen/ and scratch dirs are
#          not ours to police) ----
# Skip files deleted in the working tree but still in the index: a split
# commit stages a deletion for the NEXT commit, and gofmt fails on the stat.
# The toolchain's gofmt, not the one on PATH: go.mod's toolchain line can
# pick a newer Go than the installed one, gofmt's output differs between
# releases, and CI formats with the toolchain's.
gofmt_bin="$(go env GOROOT)/bin/gofmt"
gofmt_output=$(for f in $(git ls-files '*.go'); do [ -f "$f" ] && printf '%s\n' "$f"; done | xargs "$gofmt_bin" -l)
if [ -n "$gofmt_output" ]; then
  fail "Files not formatted:"
  echo "$gofmt_output"
  echo ""
  echo "  Fix: $gofmt_bin -w <files>"
  exit 1
fi
pass "Code formatted"

# ---- 3. Secret/credential scanning ----
echo ""
echo "  Scanning for secrets..."

# Get staged files only (what's about to be committed)
staged_files=$(staged_git diff --cached --name-only --diff-filter=ACM | grep -v '^vendor/' || true)

if [ -n "$staged_files" ]; then
  # Patterns that look like secrets
  secret_patterns="
password[[:space:]]*[:=][[:space:]]*['\"][^'\"]{6,}['\"]
secret[_-]?key[[:space:]]*[:=][[:space:]]*['\"][^'\"]{8,}['\"]
api[_-]?key[[:space:]]*[:=][[:space:]]*['\"][^'\"]{8,}['\"]
private[_-]?key[[:space:]]*[:=][[:space:]]*['\"][^'\"]{8,}['\"]
token[[:space:]]*[:=][[:space:]]*['\"][^'\"]{8,}['\"]
BEGIN[[:space:]]+RSA[[:space:]]+PRIVATE[[:space:]]+KEY
BEGIN[[:space:]]+PRIVATE[[:space:]]+KEY
BEGIN[[:space:]]+OPENSSH[[:space:]]+PRIVATE[[:space:]]+KEY
-----BEGIN PGP-----
AKIA[0-9A-Z]{16}
sk_live_[0-9a-zA-Z]{24,}
sk_test_[0-9a-zA-Z]{24,}
ghp_[0-9a-zA-Z]{36}
gho_[0-9a-zA-Z]{36}
xox[boap]-[0-9a-zA-Z-]{10,}
hooks\.slack\.com/services/T[A-Z0-9]{9,}/B[A-Z0-9]{9,}/[a-zA-Z0-9]{24}
eyJ[a-zA-Z0-9]{20,}\.eyJ[a-zA-Z0-9]{20,}\.[a-zA-Z0-9]{10,}
"

  found_secrets=""
  scan_blob=$(mktemp)
  for file in $staged_files; do
    # Skip go.sum (hashes look like secrets) and hook scripts (contain detection patterns)
    case "$file" in go.sum|*.lock|.githooks/*|Makefile) continue ;; esac
    # Scan the staged blob, not the working-tree file: an unstaged edit
    # can remove a secret the commit still carries.
    staged_git show ":$file" >"$scan_blob" 2>/dev/null || continue
    # Skip binary files
    if file -b "$scan_blob" | grep -q "binary\|image\|data"; then continue; fi

    for pattern in $secret_patterns; do
      [ -z "$pattern" ] && continue
      # A line carrying "not-a-secret: <why>" (or the older
      # "nosecret:" spelling, `make secret-scan` accepts both) is a
      # reviewed false
      # positive (e.g. code that RENDERS an env template, test
      # fixtures). The annotation lives in the diff, so every
      # exemption is visible to review, unlike --no-verify, which
      # skips every check invisibly and is banned.
      matches=$(grep -n -i -E "$pattern" "$scan_blob" 2>/dev/null | grep -v -E "not-a-secret:|nosecret:" || true)
      if [ -n "$matches" ]; then
        found_secrets="$found_secrets\n  $file:\n$matches"
      fi
    done
  done

  if [ -n "$found_secrets" ]; then
    echo ""
    fail "POTENTIAL SECRETS DETECTED!"
    printf "$found_secrets\n"
    echo ""
    echo "  Real secret → move it to the environment / .env (gitignored)."
    echo "  False positive → annotate the flagged line with a comment:"
    echo "    // not-a-secret: <why this line is safe>"
    echo "  Do NOT use --no-verify."
    echo ""
    exit 1
  fi
fi
pass "No secrets detected"

# ---- 4. Sensitive file check ----
echo ""
for file in $staged_files; do
  case "$file" in
    *.env|*.env.*|.env|credentials*|*.pem|*.key|*.p12|*.pfx|id_rsa*|id_ed25519*)
      fail "Sensitive file in commit: $file"
      echo "  If intentional: git commit --no-verify"
      exit 1
      ;;
  esac
done
pass "No sensitive files"

# ---- 5. go vet (affected packages) ----
echo ""
go run ./cmd/affected -- go vet
pass "go vet clean"

# ---- 5b. repo analyzers (CLAUDE.md hard rules as vet checks) ----
# Affected packages, except that a change under internal/analyzers or
# cmd/vettool vets everything: a new rule can flag code nobody touched.
# The binary goes in a fresh mktemp dir, never a fixed /tmp name: every
# worktree runs this hook, and a shared path let a concurrent commit on
# another branch overwrite it between build and vet, so this commit was
# vetted with that branch's analyzer set. The dir is outside the worktree
# so cmd/affected never sees it as a change.
vettool_dir=$(mktemp -d "${TMPDIR:-/tmp}/gofastr-vettool.XXXXXX")
go build -o "$vettool_dir/vettool" ./cmd/vettool
go run ./cmd/affected -all-if-changed internal/analyzers/ -all-if-changed cmd/vettool/ -- go vet -vettool="$vettool_dir/vettool"
rm -rf "$vettool_dir"
vettool_dir=""
pass "repo analyzers clean"

# ---- 5c. Model review of the staged change (background) ----
# Started once the cheap checks pass, so a commit that fails gofmt or vet
# spends no reviews, and run beside the test sweep, which takes longer
# than the review. The result is read in step 8. The checkout's own
# review3.py, so a worktree reviews with its branch's copy.
echo ""
review_note=""
review_script="$(git rev-parse --show-toplevel)/.claude/skills/review-gate/review3.py"
if [ "${GOFASTR_SKIP_COMMIT_REVIEW:-}" = "1" ]; then
  review_note="skipped (GOFASTR_SKIP_COMMIT_REVIEW=1)"
elif [ ! -f "$review_script" ]; then
  review_note="skipped: no .claude/skills/review-gate in this checkout"
elif [ -f "$(git rev-parse --git-path MERGE_HEAD)" ] || [ -f "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ] || [ -f "$(git rev-parse --git-path REVERT_HEAD)" ]; then
  review_note="skipped: merge, cherry-pick or revert commit"
elif [ -z "$(staged_git diff --cached --name-only | grep -v '\.md$' || true)" ]; then
  review_note="skipped: only Markdown staged"
else
  review_py=$(command -v python3 || command -v python || true)
  if [ -z "$review_py" ]; then
    review_note="skipped: no python3 on PATH"
  elif review_check=$("$review_py" "$review_script" --check 2>&1); review_rc=$?; [ "$review_rc" -ne 0 ] && [ "$review_rc" -ne 3 ]; then
    # A --check that crashed (exit other than 0 or 3) is a review that
    # could not run, which lets the commit through like a crashed run.
    review_note="skipped: review3.py --check exited $review_rc: $review_check"
  elif [ "$review_rc" -eq 3 ]; then
    # Neither Codex nor the Claude CLI: the hook has no reviewer to run.
    # The commit goes through; an agent runs the skill's subagent mode
    # (three Haiku subagents) before it pushes.
    review_note="skipped: $review_check. Run the review-gate skill's subagent mode before you push"
  else
    review_out=$(mktemp)
    # A stalled run counts as unusable (warn, no block) after ten minutes,
    # not review3.py's own fifteen.
    review_timeout=${GOFASTR_COMMIT_REVIEW_TIMEOUT:-600}
    if [ -n "$commit_index" ]; then
      GIT_INDEX_FILE=$commit_index "$review_py" "$review_script" --staged --timeout "$review_timeout" >"$review_out" 2>&1 &
    else
      "$review_py" "$review_script" --staged --timeout "$review_timeout" >"$review_out" 2>&1 &
    fi
    review_pid=$!
    echo "  → Model review started (three runs of $review_check, result at the end)"
  fi
fi
if [ -n "$review_note" ]; then
  warn "model review $review_note"
fi

# ---- 6. Deterministic test sweep + coverage floors (CI-identical) ----
echo ""
if [ "${GOFASTR_SKIP_COMMIT_TESTS:-}" = "1" ]; then
  warn "test sweep skipped (GOFASTR_SKIP_COMMIT_TESTS=1) — pre-push and CI still gate"
else
  echo "  → Deterministic test sweep (mirrors CI's blocking job)..."
  # Affected packages only (see the header). No -count=1: Go's cached
  # PASSes make repeat commits on unchanged packages near-instant (same
  # content-addressed cache CI relies on). The -exclude list is CI's: the
  # chromedp suites that run isolated in browser-e2e. The merged
  # coverprofile feeds the floors check below, so the suites run once.
  coverprofile=$(mktemp)
  go run ./cmd/affected \
    -exclude 'gofastr/(examples/site|examples/meridian|examples/tracker|examples/layoutlab|kiln/integration|core-ui/runtime(/hosttest)?|core-ui/widget|evals/ui-quality/internal/evalrunner|framework/headless)$' \
    -- go test -timeout=20m -coverprofile="$coverprofile" \
    -skip 'TestAppSpecCLIGeneratesEntireWorkingAppE2E|TestE2E_HotReload_BrowserAutoRefreshes|TestLivereloadSameBuildIDDoesNotReload|TestE2E_DevLoop_Examples'
  pass "Deterministic tests passed"

  echo ""
  COVERPROFILE="$coverprofile" bash scripts/coverage-floors.sh
  pass "Coverage floors hold"
fi

# ---- 7. Contracts on the uncommitted change ----
# --changed, not the whole tree: a pre-commit hook that prints findings
# from code you did not touch is a hook people bypass. The analysis still
# runs whole-tree, so a duplicate route introduced here is still caught,
# only the reporting narrows to what is uncommitted.
#
# "Uncommitted", not "staged": --changed diffs the working tree against
# HEAD, so a file with only unstaged edits is included too. That is the
# better trap, a finding in the half you left unstaged is one you are
# about to walk away from, and this is the last moment it is in your
# face.
#
# --strict because the repository carries a baseline
# (.gofastr-contracts-baseline.json): existing debt is absorbed, so the
# only things that can fail here are findings this change adds.
#
# The sweep wrote its coverage manifests where cmd/affected pointed
# GOFASTR_AXE_COVERAGE_DIR, outside the module; verify reads them there.
echo ""
echo "  → Contracts on the uncommitted change..."
GOFASTR_AXE_COVERAGE_DIR=$(go run ./cmd/affected -coverage-dir) \
  go run ./cmd/gofastr verify --no-vet --strict --changed
pass "No new contract findings"

# ---- 8. Model review result ----
# Exit codes from review3.py: 0 approve, 1 all three runs request changes,
# 2 fewer than three usable answers, 3 no reviewer. Only 1 blocks here: a
# usage limit or a network failure must not stop every commit. With no
# reviewer, step 5c already warned and started nothing.
if [ -n "$review_pid" ]; then
  echo ""
  echo "  → Waiting for the model review..."
  if wait "$review_pid"; then review_rc=0; else review_rc=$?; fi
  review_pid=""
  case $review_rc in
    0)
      pass "Model review approved"
      sed 's/^/    /' "$review_out"
      ;;
    1)
      fail "Model review: all three runs request changes"
      echo ""
      sed 's/^/    /' "$review_out"
      echo ""
      echo "  Fix the findings and commit again. If you read a finding and it is"
      echo "  wrong, commit with GOFASTR_SKIP_COMMIT_REVIEW=1 and say in the"
      echo "  commit message which finding you rejected and why. Do NOT use --no-verify."
      echo ""
      exit 1
      ;;
    *)
      warn "model review incomplete (exit $review_rc), not blocking:"
      sed 's/^/    /' "$review_out"
      ;;
  esac
fi

echo ""
pass "All pre-commit checks passed"
echo ""
