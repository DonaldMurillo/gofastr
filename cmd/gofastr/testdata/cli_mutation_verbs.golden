-- stderr
Usage of myapp gadgets create:
  -json string
    	raw JSON body: inline, @file, or - for stdin
  -meta string
    	meta (json)
  -notes string
    	notes (text)
  -price string
    	price (decimal)
  -published
    	published (bool)
  -rating float
    	rating (float)
  -released-on string
    	released_on (date)
  -status string
    	status (enum) [draft|shipped]
  -title string
    	title (string)
  -url string
    	server URL (default $MYAPP_URL, then stored config)
  -views int
    	views (int)

