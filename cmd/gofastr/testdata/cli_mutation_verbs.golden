== create all flag kinds: gadgets create --title hello --notes second --status draft --views 3 --rating 4.5 --price 19.99 --published --meta {"a":[1,2]} --released-on 2026-01-02 (exit 0)
-- request
POST /api/gadgets
{"meta":{"a":[1,2]},"notes":"second","price":"19.99","published":true,"rating":4.5,"releasedOn":"2026-01-02","status":"draft","title":"hello","views":3}
-- stdout
{
  "id": "rec-1",
  "title": "echo"
}
-- stderr


== create explicit zeros: gadgets create --views 0 --rating 0 --published=false (exit 0)
-- request
POST /api/gadgets
{"published":false,"rating":0,"views":0}
-- stdout
{
  "id": "rec-1",
  "title": "echo"
}
-- stderr


== update path-escapes id: gadgets update a/b?x --title edited (exit 0)
-- request
PUT /api/gadgets/a%2Fb%3Fx
{"title":"edited"}
-- stdout
{
  "id": "rec-1",
  "title": "echo"
}
-- stderr


== patch keeps explicit zero: gadgets patch rec-9 --views 0 --published (exit 0)
-- request
PATCH /api/gadgets/rec-9
{"published":true,"views":0}
-- stdout
{
  "id": "rec-1",
  "title": "echo"
}
-- stderr


== update via --json: gadgets update rec-9 --json {"title":"edited","meta":{"k":1}} (exit 0)
-- request
PUT /api/gadgets/rec-9
{"meta":{"k":1},"title":"edited"}
-- stdout
{
  "id": "rec-1",
  "title": "echo"
}
-- stderr


