# Harness e2e credentials (never commit). The file `env` here is
# parsed by framework/experimental/harness/e2e_real_test.go and the harness's
# loadSecretsFromRepo helper.
.harness-secrets/

# Pi internal
.pi/

# Claude Code per-session state stays local; .claude/skills/ IS tracked
# (repo-shared agent skills, see .claude/skills/gofastr-ui/SKILL.md).
.claude/sessions/
.claude/cache/
.claude/local/
.claude/settings.local.json
.claude/worktrees/
.claude/projects/
.claude/scheduled_tasks.lock
.cache/

# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Generated Go (codegen output) + local runtime state (worktree DB isolation, harness)
gen/
.gofastr/

# Scratch package examples/meridian/blueprint_gate_test.go generates the
# blueprint into before compiling it. Removed by the test itself; ignored so
# a killed run never offers it up for commit.
examples/meridian/blueprintgen/
examples/ecommerce/blueprintgen/

# Scratch packages cmd/gofastr's TestExampleBlueprintsGenerateAndCompile
# generates EVERY examples/<name>/gofastr.yml into before compiling it. Same
# contract as the two above, one directory per example; the distinct name keeps
# it from colliding with those suites under `go test -p 2`.
examples/*/blueprintbuildgen/

# Local Ollama model cache (bind-mount target of docker-compose.yml).
# Pulled models are ~hundreds of MB; never commit.
.ollama/

# Test binary
*.test

# Output
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

